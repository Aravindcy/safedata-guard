include README.md LICENSE CHANGELOG.md Dockerfile
include SECURITY.md SECURITY_MODEL.md THREAT_MODEL.md BENCHMARKS.md REDESIGN_PLAN.md
recursive-include tests *.py
recursive-include examples *.py *.md

# Keep build artifacts, caches, and local outputs out of the source distribution.
global-exclude *.pyc
global-exclude *.pyo
prune **/__pycache__
prune .pytest_cache
prune build
prune dist
exclude exported_data.csv output.csv customer_data.csv .env
